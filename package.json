{
  "name": "devnotes",
  "productName": "devNotes",
  "version": "2.0.1",
  "description": "devNotes (React + TypeScript + Tailwind)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/bump-version.cjs && tsc && vite build && node scripts/run-electron-builder.cjs",
    "build:dir": "tsc && vite build && node scripts/run-electron-builder.cjs --dir",
    "build:all": "node scripts/bump-version.cjs && tsc && vite build && node scripts/run-electron-builder.cjs --mac --win",
    "build:web": "tsc && vite build",
    "build:mobile": "tsc && BUILD_TARGET=capacitor vite build",
    "cap:sync": "bun run build:mobile && cap sync android",
    "cap:open": "cap open android",
    "cap:apk": "bun run build:mobile && cap sync android && cd android && ./gradlew assembleDebug",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build",
    "icons": "node scripts/generate-iconset.cjs && node scripts/generate-ico.cjs && node scripts/generate-icns.cjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@xitanggg/node-insert-text": "^1.5.1",
    "electron-macos-window-extensions": "^0.1.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@codemirror/state": "^6.7.6",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/plugin-highlight": "^7.22.2",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "cherry-markdown": "^0.11.10",
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.4.4",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "shiki": "^4.5.0",
    "tailwindcss": "^3.4.19",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.devnotes.app",
    "productName": "devNotes",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "lzyszds",
      "repo": "devNotes-electron",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "node_modules/@xitanggg/node-insert-text/**/*",
      "node_modules/@xitanggg/node-insert-text-darwin-*/**/*",
      "node_modules/@xitanggg/node-insert-text-win32-*/**/*",
      "!**/*.map",
      "!**/tesseract-core.wasm",
      "!**/tesseract-core.wasm.js",
      "!**/tesseract-core-simd.wasm",
      "!**/tesseract-core-simd.wasm.js",
      "!**/tesseract-core-relaxedsimd.wasm",
      "!**/tesseract-core-relaxedsimd.wasm.js",
      "!**/cherry-markdown/node_modules/**"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": "Xiamen Huiqi Xincheng Media Co., Ltd. (M7446VU8K4)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "asarUnpack": [
      "node_modules/@xitanggg/**/*"
    ]
  }
}
