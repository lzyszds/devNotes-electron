{
  "name": "devnotes",
  "productName": "DevNotes",
  "version": "2026.4.2920",
  "description": "DevNotes (React + TypeScript + Tailwind)",
  "main": "dist-electron/main.js",
  "scripts": {
    "sync:vditor": "node scripts/sync-vditor-assets.cjs",
    "predev": "npm run sync:vditor",
    "preelectron:dev": "npm run sync:vditor",
    "prebuild": "npm run sync:vditor",
    "prebuild:all": "npm run sync:vditor",
    "prebuild:web": "npm run sync:vditor",
    "dev": "vite",
    "build": "tsc && vite build && node scripts/run-electron-builder.cjs",
    "build:all": "tsc && vite build && node scripts/run-electron-builder.cjs --mac --win",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build",
    "icons": "node scripts/generate-iconset.cjs && node scripts/generate-ico.cjs && node scripts/generate-icns.cjs"
  },
  "dependencies": {
    "cherry-markdown": "^0.11.10",
    "electron-log": "^5.2.4",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.12",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vditor": "^3.11.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.devnotes.app",
    "productName": "DevNotes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "role": "Editor",
        "icon": "assets/icon"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档",
        "role": "Editor",
        "icon": "assets/icon"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    }
  }
}
